#!/usr/bin/env bash
# sirven: the owner's command for access that is already installed. a sketch for the alpha cut.
#
#   sirven grant inspect    the level in force and the active grants, read from state files
#   sirven grant rollback   reverse the most recent grant change, found in the audit log
#   sirven runtime ...      the Solo egress runtime for the owner's personal agent: see
#                           docs/runtime-interface.md and sirven runtime --help
#   sirven awake ...        keep the Mac awake while the agent has work in flight (macos only)
#   sirven phone ...        the owner's iPhone, driven by the owner's agent: lib/phone_bridge.py
#   sirven add|remove ...   optional components, copied into the owner's own folder:
#                           lib/components.sh and docs/COMPONENTS.md. core never needs one
#
# inspect only reads. rollback is a plan like install.sh: --dry-run prints it and changes
# nothing, and without --dry-run the identical plan is printed and then applied, under the
# same rule: a fake root, or a real linux machine as root. on a real machine (not a container)
# it asks you to type yes first, or takes --yes.
#
# after alpha: live sessions and per-command entries come from the forced-command wrapper on
# the agent's SSH key, which is designed, not built. this command reads the grant records, the
# install record, and the grant entries the package itself writes to the audit log.

if [ -z "${BASH_VERSION:-}" ]; then
  echo "error: run this with bash, for example: bash $0" >&2
  exit 1
fi

set -euo pipefail

# ---- root gate: begin. the same text is at the top of install.sh, uninstall.sh and bin/sirven; tests/unit/test_gate.sh keeps it so.
# when this runs as root, every line of code and every tool it uses must come from a place that only root (and the owner who
# ran sudo) controls. nothing here asks the folder it is judging where the trusted copy is, or lets that folder judge itself:
#   - the search path is reset (/usr/local/sbin and /usr/local/bin are added back only if root alone controls them) and every tool
#     the gate uses is named by its absolute path;
#   - the kept copy is the fixed path below, never read from project.json or any other file of the folder under test;
#   - the checker is the text of this block, not a file of the folder under test;
#   - the folder is resolved to its physical path once, and every library is read through that path;
#   - it runs for every command and every flag as root, --dry-run, --help and --prefix included: a dry run reads the same code.
# what it does: a copy of this package other than the kept one is never run as root when the kept one exists (install is the
# exception, to upgrade, and only from a folder that nobody but root and the owner can write). with no kept copy, the folder it
# runs from must be one that nobody but root and the owner can write, the whole way down and up. the kept copy itself must be
# that too. the safe way to run any root command is the one install prints: the launcher /usr/local/sbin/sirven when its folder is safe, else the kept copy.
if [ -z "${BASH_SOURCE[0]:-}" ]; then
  printf 'error: run this as a file, for example: bash install.sh ... . started from standard input or with -c it cannot tell which folder it belongs to, and so cannot check the code it would read. nothing was changed.\n' >&2
  exit 2
fi
if [ "$EUID" -eq 0 ]; then
  PATH=/usr/sbin:/usr/bin:/sbin:/bin
  export PATH
  # (bash has already read BASH_ENV and ENV before this line, for this script; sudo removes them. this protects what is started from here.)
  unset BASH_ENV ENV CDPATH LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT PYTHONPATH PYTHONHOME PYTHONSTARTUP TMPDIR
fi
SIRVEN_KEPT=/var/lib/sirven/package

# sirven_vet FOLDER OWNER: exit 0 when nobody but root and OWNER can change anything in FOLDER or replace anything on the way to
# it; otherwise exit 3 and print each place somebody else can write. read only. this text is the checker.
sirven_vet() {
  /usr/bin/python3 -I - "$1" "$2" <<'PY'
import grp, os, pwd, re, stat, struct, sys
folder, owner = sys.argv[1], sys.argv[2]
ACCESS_LIST, USER, GROUP_OBJ, GROUP, MASK = "system.posix_acl_access", 0x02, 0x04, 0x08, 0x10
LOGIN_DEFS = "/etc/login.defs"
# the only shells a system account in group root may have: nothing that gives a login (nologin, false) or one fixed program
# that Fedora gives its stock accounts (sync, shutdown, halt). an empty shell field means /bin/sh, so it is not on the list.
QUIET_SHELLS = ("/sbin/nologin", "/usr/sbin/nologin", "/bin/false", "/usr/bin/false", "/bin/sync", "/sbin/shutdown", "/sbin/halt")
users = {0}
try:
    users.add(pwd.getpwnam(owner).pw_uid)
except KeyError:
    pass
def uid_name(number):
    try:
        return pwd.getpwuid(number).pw_name
    except KeyError:
        return "user number %d" % number
def gid_name(number):
    try:
        return grp.getgrgid(number).gr_name
    except KeyError:
        return "group number %d" % number
def system_limit():  # the first ordinary user number: UID_MIN of the login definitions, 1000 when they do not say
    try:
        with open(LOGIN_DEFS) as handle:
            found = re.search(r"^[ \t]*UID_MIN[ \t]+([0-9]+)[ \t]*(#.*)?$", handle.read(), re.M)
        return int(found.group(1)) if found else 1000
    except (OSError, ValueError):
        return 1000
def harmless(name, gid, limit):
    # root and the owner are trusted. in group root (number 0) so is a system account (a user number below the first ordinary one)
    # whose shell is on the short list QUIET_SHELLS. a locked password counts for nothing: a key login, su, cron or a service still runs
    # as the account. every other member is an outsider.
    try:
        entry = pwd.getpwnam(name)
    except KeyError:
        return False
    if entry.pw_uid in users:
        return True
    return gid == 0 and entry.pw_uid < limit and entry.pw_shell in QUIET_SHELLS
def outsiders(gid):  # the members of group gid who could still change what the group can write, by name
    try:
        members = set(grp.getgrgid(gid).gr_mem)
    except KeyError:
        if gid != 0:
            return ["(the members of group number %d are unknown)" % gid]
        members = set()
    members.update(entry.pw_name for entry in pwd.getpwall() if entry.pw_gid == gid)
    limit = system_limit()
    return sorted(name for name in members if not harmless(name, gid, limit))
def group_trusted(gid):
    return not outsiders(gid)
def entries(path):
    if not hasattr(os, "getxattr"):
        return []
    try:
        blob = os.getxattr(path, ACCESS_LIST, follow_symlinks=False)
    except OSError:
        return []
    return [struct.unpack_from("<HHI", blob, offset) for offset in range(4, len(blob) - 7, 8)]
def writers(path, info, sticky_parent):
    # sticky_parent: this folder is on the way to the package, sticky and open to everyone (like /tmp), and the folder below it is
    # judged with no such allowance. the sticky bit stops anyone but the owner of an entry from renaming or replacing it, so the
    # open bit and the group bit (both only let others add entries) cannot change what is already there. never true for the package
    # folder or anything inside it.
    if info.st_uid not in users:
        return "owned by %s, who can change its mode" % uid_name(info.st_uid)
    mode = stat.S_IMODE(info.st_mode)
    if mode & 0o002 and not sticky_parent:
        return "writable by everyone (mode %o)" % mode
    listed = entries(path)
    mask = next((perm for tag, perm, _ in listed if tag == MASK), 7)
    # with an access list the group bits of the mode are the mask, not the owning group's own permission: that is the group
    # entry (tag 0x04), cut by the mask. judging the mask as the group's would name the group for what an entry did.
    own_group = next((perm for tag, perm, _ in listed if tag == GROUP_OBJ), None)
    group_write = mode & 0o020 if own_group is None else own_group & mask & 0o2
    if group_write and not sticky_parent:
        others = outsiders(info.st_gid)
        if others:
            return "writable by the group %s (mode %o), which has other members: %s" % (gid_name(info.st_gid), mode, ", ".join(others))
    for tag, perm, number in listed:
        if perm & mask & 0o2:
            if tag == USER and number not in users:
                return "an access list entry gives %s write" % uid_name(number)
            if tag == GROUP and not group_trusted(number):
                return "an access list entry gives the group %s write" % gid_name(number)
    return None
problems = []
try:
    real = os.path.realpath(folder)
    parts = [part for part in real.split("/") if part]
    path = "/"
    allowed = False  # the folder above was let through as a sticky parent: this one gets no such allowance
    for index in range(len(parts) + 1):
        if index:
            path = os.path.join(path, parts[index - 1])
        info = os.lstat(path)
        if stat.S_ISDIR(info.st_mode):
            sticky = (index < len(parts) and not allowed and info.st_mode & stat.S_ISVTX and info.st_mode & 0o002
                      and info.st_uid in users)
            reason = writers(path, info, bool(sticky))
            allowed = bool(sticky) and not reason
            if reason:
                problems.append((path, reason))
        else:
            allowed = False
    pending = [real]
    while pending:
        item = pending.pop()
        info = os.lstat(item)
        if stat.S_ISLNK(info.st_mode):
            target = os.path.realpath(item)
            if not (target + "/").startswith(real + "/"):
                problems.append((item, "a link to %s, outside the package" % target))
            continue
        reason = writers(item, info, False)
        if reason:
            problems.append((item, reason))
        if stat.S_ISDIR(info.st_mode):
            with os.scandir(item) as listing:
                pending.extend(entry.path for entry in listing)
except OSError as error:
    problems.append((error.filename or folder, "cannot be examined (%s)" % error.strerror))
except Exception as error:
    problems.append((folder, "cannot be examined (%s: %s)" % (type(error).__name__, error)))
seen, shown = set(), 0
for path, reason in problems:
    if path in seen:
        continue
    seen.add(path)
    if shown < 12:
        print("  %s: %s" % (path, reason))
    shown += 1
if shown > 12:
    print("  and %d more" % (shown - 12))
sys.exit(3 if problems else 0)
PY
}

# sirven_flag_value FLAG ARGUMENT...: print the value of FLAG, or of --flag=VALUE, from ARGUMENT...; exit 1 when absent
sirven_flag_value() {
  local flag="$1"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      "$flag")
        [ "$#" -ge 2 ] || return 1
        case "$2" in --*) return 1 ;; esac
        printf '%s' "$2"
        return 0
        ;;
      "$flag"=*) printf '%s' "${1#*=}"; return 0 ;;
    esac
    shift
  done
  return 1
}

# sirven_refuse_owner_name NAME SERVICE_USER: exit 2 when NAME is not a plain owner account, or is the service account
sirven_refuse_owner_name() {
  local name="$1" service_user="$2"
  case "$name" in
    '' | *[!A-Za-z0-9._-]*)
      printf 'error: --owner must be a plain account name\n' >&2
      exit 2
      ;;
  esac
  if [ "$name" = "$service_user" ]; then
    printf 'error: refusing --owner %s: that is the service user account, not the owner who holds the audit log. nothing was changed.\n' "$name" >&2
    exit 2
  fi
}

# sirven_trusted_sudo_user SERVICE_USER: print the sudo account name when the environment corroborates it, else print nothing
sirven_trusted_sudo_user() {
  local service_user="$1"
  /usr/bin/python3 -I - "$service_user" <<'PY'
import os, pwd, re, sys
service_user = sys.argv[1]
sudo_user = os.environ.get("SUDO_USER", "")
sudo_uid = os.environ.get("SUDO_UID", "")
if not sudo_user or sudo_user == "root":
    raise SystemExit
if not sudo_uid.isdigit():
    raise SystemExit
sudo_uid = int(sudo_uid)
try:
    entry = pwd.getpwnam(sudo_user)
except KeyError:
    raise SystemExit
if entry.pw_uid != sudo_uid:
    raise SystemExit
if sudo_user == service_user:
    raise SystemExit
uid_min = 1000
try:
    with open("/etc/login.defs") as handle:
        found = re.search(r"^[ \t]*UID_MIN[ \t]+([0-9]+)[ \t]*(#.*)?$", handle.read(), re.M)
        if found:
            uid_min = int(found.group(1))
except OSError:
    pass
if entry.pw_uid < uid_min:
    raise SystemExit
try:
    loginuid = open("/proc/self/loginuid").read().strip()
except OSError:
    raise SystemExit
if loginuid in ("4294967295", "-1", ""):
    raise SystemExit
if not loginuid.isdigit() or int(loginuid) != sudo_uid:
    raise SystemExit
print(sudo_user)
PY
}

# sirven_gate_owner SERVICE_USER ARGUMENT...: set SIRVEN_GATE_OWNER for vetting and for the libraries; print the name
sirven_gate_owner() {
  local service_user="$1"
  shift
  local explicit="" trusted="" owner=""
  explicit="$(sirven_flag_value --owner "$@")" || explicit=""
  trusted="$(sirven_trusted_sudo_user "$service_user")"
  if [ -n "$explicit" ]; then
    sirven_refuse_owner_name "$explicit" "$service_user"
    owner="$explicit"
  elif [ -n "$trusted" ]; then
    owner="$trusted"
  else
    owner=root
  fi
  SIRVEN_GATE_OWNER="$owner"
  export SIRVEN_GATE_OWNER
  printf '%s' "$owner"
}

# sirven_gate ENTRY KIND ARGUMENT...: ENTRY is this script's path below the package folder (install.sh, uninstall.sh, bin/sirven);
# KIND is install for an install, anything else for the rest. ROOT_DIR is this script's physical folder. as root on linux it
# either returns, having vetted the folder it will read its libraries from, or runs the kept copy instead, or refuses.
sirven_gate() {
  local entry="$1" kind="$2" kept="" output who dir real service_user owner
  shift 2
  [ "$EUID" -eq 0 ] || return 0
  [ "$(/usr/bin/uname -s)" = Linux ] || return 0
  if [ ! -x /usr/bin/python3 ]; then
    printf 'error: refusing to run as root: there is no /usr/bin/python3 to check the code with, and the check does not use any other. nothing was changed.\n' >&2
    exit 2
  fi
  # tools under /usr/local (tailscale, cloudflared, bb) are found only if root alone controls the folder and every folder above
  # it, checked now with the same checker; they come after the system folders, and a folder that fails is left out and said so
  # (the physical path is vetted and the physical path is what goes on PATH: a link at /usr/local/bin that somebody can swap after
  # the check would otherwise be checked as one folder and searched as another)
  for dir in /usr/local/sbin /usr/local/bin; do
    [ -d "$dir" ] || continue
    real="$(cd -P "$dir" 2>/dev/null && pwd -P)" || real=""
    if [ -n "$real" ] && output="$(sirven_vet "$real" root 2>&1)"; then
      PATH="$PATH:$real"
    else
      printf 'warning: %s is not on root'"'"'s search path: somebody besides root can change it or something in it:\n%s\n' "$dir" "$output" >&2
    fi
  done
  export PATH
  service_user="$(sirven_flag_value --user "$@")" || service_user=agent
  owner="$(sirven_gate_owner "$service_user" "$@")"
  who="any account other than root"
  [ "$owner" = root ] || who="any account other than root and $owner"
  if [ -f "$SIRVEN_KEPT/$entry" ]; then kept="$(cd -P "$SIRVEN_KEPT" && pwd -P)"; fi
  if [ -n "$kept" ] && [ "$ROOT_DIR" != "$kept" ]; then
    if [ "$kind" = install ] && sirven_vet "$ROOT_DIR" "$owner" >/dev/null 2>&1; then return 0; fi
    if output="$(sirven_vet "$kept" "$owner" 2>&1)"; then
      printf 'running the kept copy %s instead of %s: root runs the root-owned copy, not a folder an agent may have changed.\n' "$kept" "$ROOT_DIR" >&2
      exec "$BASH" "$kept/$entry" "$@"
    fi
    # the kept copy is not trusted (somebody loosened the state directory). the folder this was started from may still be:
    # an emergency command must not be refused for that, but it runs only if this folder passes the same check
    if sirven_vet "$ROOT_DIR" "$owner" >/dev/null 2>&1; then
      printf 'warning: the kept copy %s can be changed by %s, so it was not used; running %s, which only root and %s can write.\n%s\n' "$kept" "$who" "$ROOT_DIR" "$owner" "$output" >&2
      return 0
    fi
    printf 'error: refusing to run as root: the kept copy %s can be changed by %s, and so can %s:\n%s\nnothing was changed.\n' "$kept" "$who" "$ROOT_DIR" "$output" >&2
    exit 2
  fi
  if ! output="$(sirven_vet "$ROOT_DIR" "$owner" 2>&1)"; then
    printf 'error: refusing to run as root from %s: %s can change the code there, and it would run as root:\n%s\n' "$ROOT_DIR" "$who" "$output" >&2
    printf 'there is no kept copy to run instead. run it from a folder only %s can write, or, once installed, with the root command that install prints (it is the launcher when its folder is safe, and the kept copy otherwise).\nnothing was changed.\n' "${owner}" >&2
    exit 2
  fi
}
# ---- root gate: end

# find the package folder, following a symbolic link such as /usr/local/bin/sirven.
# readlink without -f, because macos readlink has no -f.
_sirven_self="${BASH_SOURCE[0]}"
while [ -L "$_sirven_self" ]; do
  _sirven_link="$(readlink "$_sirven_self")"
  case "$_sirven_link" in
    /*) _sirven_self="$_sirven_link" ;;
    *) _sirven_self="$(dirname "$_sirven_self")/$_sirven_link" ;;
  esac
done
# the physical folder, resolved once; every library is read through it (a link swapped in later changes nothing)
ROOT_DIR="$(cd -P "$(dirname "$_sirven_self")/.." && pwd -P)"
if [ "${BASH_SOURCE[0]}" = "$0" ]; then sirven_gate bin/sirven sirven "$@"; fi

# shellcheck source=lib/common.sh
. "$ROOT_DIR/lib/common.sh"
# shellcheck source=lib/plan.sh
. "$ROOT_DIR/lib/plan.sh"
# shellcheck source=lib/preflight.sh
. "$ROOT_DIR/lib/preflight.sh"
# shellcheck source=lib/layout.sh
. "$ROOT_DIR/lib/layout.sh"
# shellcheck source=lib/audit.sh
. "$ROOT_DIR/lib/audit.sh"
# shellcheck source=lib/access_control.sh
. "$ROOT_DIR/lib/access_control.sh"
# shellcheck source=lib/components.sh
. "$ROOT_DIR/lib/components.sh"
# shellcheck source=lib/lock.sh
. "$ROOT_DIR/lib/lock.sh"

after_alpha_sessions() {
  printf 'sessions already open keep the rights they started with until they end. ending them belongs to the forced-command wrapper, built after alpha. to cut everything now: %s (add --dry-run to read the plan first)' "$(layout_root_command revoke)"
}

usage() {
  cat <<END
usage:
  sirven grant inspect [options]     show the level in force and the active grants
  sirven grant rollback [options]    reverse the most recent grant change
  sirven grant repair [options]      remove what a grant made by an older version left behind
  sirven runtime serve|status|fetch|classify|decisions|exec
                                     the Solo egress runtime: sirven runtime --help
  sirven awake [command]             keep the Mac awake while your agent works; sirven awake --help
  sirven phone COMMAND               let your agent drive your plugged-in iPhone, with consent.
                                     sirven phone --help lists the commands
  sirven add --list                  optional components. sirven never needs one
  sirven add NAME | remove NAME      add or remove one, as a plan: sirven add --help

options:
  --prefix PATH    read a fake root that install.sh was applied to with --prefix
  --user NAME      the service user (default: agent). inspect shows every user without it
  --dry-run        rollback or repair: print the plan or the list and change nothing
  --yes, -y        rollback on a real machine: apply without asking you to type yes (or SIRVEN_YES=1)
  --path PATH      repair only: a granted folder, when the grant record is gone (after an older uninstall)
  --help           show this help

rollback reverses the newest grant entry in the audit log, and refuses when the grant record
no longer matches it. a rollback is itself a grant change, so a second rollback undoes the first.

examples:
  sirven grant inspect
  sirven grant rollback --dry-run
END
}

usage_error() {
  printf 'error: %s\n' "$1" >&2
  printf 'run sirven --help for usage.\n' >&2
  exit 64
}

parse_arguments() {
  ACTION=""
  DRY_RUN=no
  ASSUME_YES=no
  PREFIX=""
  SERVICE_USER=agent
  USER_GIVEN=no
  REPAIR_PATHS_TEXT=""
  OWNER="${SIRVEN_GATE_OWNER:-$(id -un)}"
  case "${1:-}" in
    -h | --help | help) usage; exit 0 ;;
    grant) shift ;;
    '') usage_error "a command is needed: grant inspect or grant rollback" ;;
    *) usage_error "unknown command '$1'" ;;
  esac
  case "${1:-}" in
    inspect | rollback | repair) ACTION="$1"; shift ;;
    -h | --help) usage; exit 0 ;;
    '') usage_error "grant needs inspect, rollback or repair" ;;
    *) usage_error "unknown grant command '$1'; revoking one grant is designed, not built" ;;
  esac
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=yes ;;
      --yes | -y) ASSUME_YES=yes ;;
      --prefix)
        [ "$#" -ge 2 ] || usage_error "--prefix needs a value"
        PREFIX="$2"
        shift
        ;;
      --prefix=*) PREFIX="${1#*=}" ;;
      --user)
        [ "$#" -ge 2 ] || usage_error "--user needs a value"
        SERVICE_USER="$2"
        USER_GIVEN=yes
        shift
        ;;
      --user=*) SERVICE_USER="${1#*=}"; USER_GIVEN=yes ;;
      --path)
        [ "$#" -ge 2 ] || usage_error "--path needs a value"
        REPAIR_PATHS_TEXT="${REPAIR_PATHS_TEXT}$2
"
        shift
        ;;
      --path=*) REPAIR_PATHS_TEXT="${REPAIR_PATHS_TEXT}${1#*=}
" ;;
      -h | --help) usage; exit 0 ;;
      *) usage_error "unknown option '$1'" ;;
    esac
    shift
  done
  case "$SERVICE_USER" in
    '' | [!a-z_]* | *[!a-z0-9_-]*) usage_error "--user must be a plain lowercase account name" ;;
  esac
  if [ -n "$PREFIX" ]; then
    case "$PREFIX" in
      /*) ;;
      *) usage_error "--prefix must be an absolute path" ;;
    esac
    if ! checked_prefix="$(prefix_normalize "$PREFIX")"; then usage_error "$checked_prefix"; fi
    PREFIX="$checked_prefix"
  fi
  if [ -n "$REPAIR_PATHS_TEXT" ] && [ "$ACTION" != repair ]; then
    usage_error "--path goes with repair only"
  fi
  if [ "$ACTION" = inspect ] && [ "$DRY_RUN" = yes ]; then
    usage_error "--dry-run goes with rollback or repair; inspect never changes anything"
  fi
  if [ -n "${SIRVEN_OS_OVERRIDE:-}" ] && [ "$ACTION" = rollback ] && [ "$DRY_RUN" != yes ] && [ -z "$PREFIX" ]; then
    usage_error "SIRVEN_OS_OVERRIDE only works with --dry-run or --prefix"
  fi
}

need_python() {
  command -v python3 >/dev/null 2>&1 || die "python3 was not found on PATH; reading grant records needs it"
}

# read_grant RECORD: set GRANT_LEVEL (or none) and GRANT_PATHS_TEXT (one path per line).
# a missing record is no grant; an unreadable one returns 1.
read_grant() {
  local key value shown
  GRANT_LEVEL=none
  GRANT_WRITE=false
  GRANT_PRINCIPAL=""
  GRANT_EXPIRES=never
  GRANT_CAN_GRANT=false
  GRANT_PATHS_TEXT=""
  [ -f "$1" ] || return 0
  shown="$(grant_compiler show --record "$1")" || return 1
  while IFS='=' read -r key value; do
    case "$key" in
      level) GRANT_LEVEL="$value" ;;
      write_allowed) GRANT_WRITE="$value" ;;
      principal) GRANT_PRINCIPAL="$value" ;;
      expires) GRANT_EXPIRES="$value" ;;
      can_grant) GRANT_CAN_GRANT="$value" ;;
      path) GRANT_PATHS_TEXT="${GRANT_PATHS_TEXT}${value}
" ;;
    esac
  done <<END
$shown
END
}

# read_last_grant: the newest grant entry for SERVICE_USER, into LAST_* variables.
read_last_grant() {
  local key value found
  LAST_TIME=""
  LAST_REASON=""
  LAST_LEVEL=none
  LAST_PREVIOUS_LEVEL=none
  LAST_PATHS_TEXT=""
  LAST_PREVIOUS_PATHS_TEXT=""
  LAST_SKIPPED=0
  found="$(grant_compiler last-grant --audit "$1" --user "$SERVICE_USER")" || die "the audit log $1 cannot be read"
  while IFS='=' read -r key value; do
    case "$key" in
      time) LAST_TIME="$value" ;;
      reason) LAST_REASON="$value" ;;
      level) LAST_LEVEL="$value" ;;
      previous_level) LAST_PREVIOUS_LEVEL="$value" ;;
      path) LAST_PATHS_TEXT="${LAST_PATHS_TEXT}${value}
" ;;
      previous_path) LAST_PREVIOUS_PATHS_TEXT="${LAST_PREVIOUS_PATHS_TEXT}${value}
" ;;
      skipped_lines) LAST_SKIPPED="$value" ;;
    esac
  done <<END
$found
END
}

count_lines() {
  if [ -z "$1" ]; then printf '0'; else printf '%s' "$1" | grep -c .; fi
}

# set_grant_paths TEXT: GRANT_PATHS from one path per line.
set_grant_paths() {
  local path
  GRANT_PATHS=()
  while IFS= read -r path; do
    if [ -n "$path" ]; then GRANT_PATHS[${#GRANT_PATHS[@]}]="$path"; fi
  done <<END
$1
END
}

describe_grant() {
  if [ "$1" = none ]; then
    printf 'no grant'
  else
    printf 'level %s on %s path(s)' "$1" "$(count_lines "$2")"
  fi
}

inspect_policy_copy() {
  local level="$1" copy
  copy="${PREFIX}$CONFIG_DIR/levels/$level.json"
  if [ ! -f "$copy" ]; then
    printf 'missing: %s is not installed' "$CONFIG_DIR/levels/$level.json"
  elif cmp -s "$copy" "$ROOT_DIR/levels/$level.json"; then
    printf '%s, the same as levels/%s.json' "$CONFIG_DIR/levels/$level.json" "$level"
  else
    printf '%s, different from levels/%s.json in this copy of the package' "$CONFIG_DIR/levels/$level.json" "$level"
  fi
}

inspect() {
  local grants record name shown=0 revoked="" log install_record steps
  need_python
  grants="${PREFIX}$CONFIG_DIR/grants"
  say "$PACKAGE grants"
  say "  prefix: ${PREFIX:-none, the real root}"
  if [ ! -d "$grants" ]; then
    say ""
    say "no grants folder at $grants: nothing is installed here."
    return 0
  fi
  for record in "$grants"/*.json; do
    [ -f "$record" ] || continue
    name="$(basename "$record" .json)"
    if [ "$USER_GIVEN" = yes ] && [ "$name" != "$SERVICE_USER" ]; then continue; fi
    if ! read_grant "$record" 2>/dev/null; then
      say ""
      say "service user $name: the grant record $record cannot be read"
      continue
    fi
    shown=$((shown + 1))
    say ""
    say "service user $name"
    say "  level in force: $GRANT_LEVEL (write allowed: $GRANT_WRITE)"
    say "  policy: $(inspect_policy_copy "$GRANT_LEVEL")"
    say "  principal: $GRANT_PRINCIPAL"
    say "  expires: $GRANT_EXPIRES"
    say "  can grant further: $GRANT_CAN_GRANT"
    say "  paths:"
    printf '%s' "$GRANT_PATHS_TEXT" | sed 's/^/    /'
  done
  for record in "$grants"/*.json.revoked; do
    [ -f "$record" ] || continue
    revoked="$revoked $(basename "$record" .json.revoked)"
  done
  if [ "$shown" -eq 0 ]; then
    say ""
    say "no active grants."
  fi
  say ""
  say "revoked by the kill switch:${revoked:- none}"

  log="${PREFIX}$(audit_log_file)"
  if [ "$USER_GIVEN" = yes ]; then
    if [ ! -e "$log" ]; then
      say "last grant change for $SERVICE_USER: no audit log at $log"
    elif [ ! -r "$log" ]; then
      say "last grant change for $SERVICE_USER: the audit log belongs to the owner; run this as the owner to read it"
    else
      read_last_grant "$log"
      if [ -z "$LAST_TIME" ]; then
        say "last grant change for $SERVICE_USER: none in the audit log"
      else
        say "last grant change for $SERVICE_USER: $LAST_TIME ($LAST_REASON), $(describe_grant "$LAST_LEVEL" "$LAST_PATHS_TEXT"), before it $(describe_grant "$LAST_PREVIOUS_LEVEL" "$LAST_PREVIOUS_PATHS_TEXT")"
      fi
    fi
  fi

  install_record="${PREFIX}$(layout_record_file)"
  if [ -r "$install_record" ]; then
    steps="$(grep -c . "$install_record" || true)"
    say "install record: $steps steps this package can reverse; read them with ./uninstall.sh --dry-run"
  elif [ -e "$install_record" ]; then
    say "install record: $(layout_record_file) belongs to root; run this with sudo to read it"
  else
    say "install record: none"
  fi
  say ""
  say "after alpha: live sessions and the commands the agent runs come from the forced-command wrapper, which is not built yet. this view reads files only."
}

# repair_grant: for an install made by an older version, whose own undo leaves the default list, the mask and
# the folder owner's entry behind. removes what the grant in the grant record added, from the granted folders
# and the pass-through parents, with this package's helper. run it, then the old install's uninstall.sh, then
# install.sh of this version. with the account already gone it removes what an old undo left instead.
repair_grant() {
  local record kind path helper status=0 failed=0 flags="" scratch refusal
  [ "$OPERATING_SYSTEM" = linux ] || die "repair is for linux access control lists; this machine is $OPERATING_SYSTEM"
  need_python
  if [ "$DRY_RUN" != yes ]; then lock_take 60 refuse; fi
  record="${PREFIX}$(access_control_record_file)"
  if [ -n "$REPAIR_PATHS_TEXT" ]; then
    GRANT_LEVEL=observer
    GRANT_PATHS_TEXT="$REPAIR_PATHS_TEXT"
  else
    [ -f "$record" ] || die "no grant record at $record, so there is nothing to repair. after an older uninstall removed the record, name the folders: sirven grant repair --path FOLDER [--path FOLDER]"
    read_grant "$record" || DIE_STATUS=2 die "the grant record $record cannot be read; nothing was changed"
    [ "$GRANT_LEVEL" != none ] || die "the grant record $record holds no grant; nothing to repair"
  fi
  set_grant_paths "$GRANT_PATHS_TEXT"
  scratch="$STAGE_DIR/repair-folders.txt"
  set -- folders --level "$ROOT_DIR/levels/$GRANT_LEVEL.json" --os linux --user "$SERVICE_USER" --package "$PACKAGE"
  local index=0
  while [ "$index" -lt "${#GRANT_PATHS[@]}" ]; do
    set -- "$@" --path "${GRANT_PATHS[index]}"
    index=$((index + 1))
  done
  grant_compiler "$@" > "$scratch" || DIE_STATUS=2 die "the grant compiler refused the paths in $record; nothing was changed"
  helper="$ROOT_DIR/lib/access_control_snapshot.sh"
  [ "$DRY_RUN" = yes ] && flags="--dry-run"
  say "$PACKAGE grant repair for $SERVICE_USER: removes what an older grant added (this version's helper)."
  if [ "$DRY_RUN" != yes ]; then
    # this changes access lists on the machine without a plan_apply, so it asks the same way.
    PLAN_PREFIX="$PREFIX"
    PLAN_OPERATING_SYSTEM="$OPERATING_SYSTEM"
    refusal="$(plan_real_apply_refusal)"
    [ -z "$refusal" ] || DIE_STATUS=3 die "not applied: $refusal"
    while IFS="$(printf '\t')" read -r kind path; do
      say "  repair: ${PREFIX}$path"
    done < "$scratch"
    plan_confirm_real_apply || exit 3
  fi
  while IFS="$(printf '\t')" read -r kind path; do
    case "$kind" in
      tree) bash "$helper" repair "${PREFIX}$path" yes "$SERVICE_USER" $flags || failed=1 ;;
      alone) bash "$helper" repair "${PREFIX}$path" no "$SERVICE_USER" $flags || failed=1 ;;
    esac
  done < "$scratch"
  [ "$failed" -eq 0 ] || status=1
  if [ "$DRY_RUN" != yes ] && [ "$status" -eq 0 ]; then
    say "done. next, for an install made by an older version: run its uninstall.sh (the pinned copy in $STATE_DIR/package), then install.sh of this version."
  fi
  return "$status"
}

rollback_header() {
  local mode="apply: the plan below is printed, then applied"
  [ "$DRY_RUN" = yes ] && mode="dry run: nothing will be changed"
  say "$PACKAGE grant rollback plan"
  say "  operating system: $OPERATING_SYSTEM"
  say "  service user: $SERVICE_USER"
  say "  reversing: the grant change at $LAST_TIME ($LAST_REASON)"
  say "  now: $(describe_grant "$GRANT_LEVEL" "$GRANT_PATHS_TEXT")"
  say "  after: $(describe_grant "$LAST_PREVIOUS_LEVEL" "$LAST_PREVIOUS_PATHS_TEXT")"
  say "  prefix: ${PREFIX:-none, the real root}"
  say "  mode: $mode"
}

# every current entry is removed, then the earlier grant is applied again from nothing. removing
# only the difference goes wrong with nested paths and shared parent folders, and chmod +a on
# macos adds a second entry rather than replacing one. the grant steps come after removals that
# undo their end state, so they are assumed undone and always run.
build_rollback_plan() {
  local record
  record="$(rooted "$(access_control_record_file)")"
  plan_reset
  LEVEL="$GRANT_LEVEL"
  load_level
  set_grant_paths "$GRANT_PATHS_TEXT"
  plan_section "remove the access in force now"
  plan_access_control_quiesce
  plan_access_control_remove_paths
  plan_assume_undone
  if [ "$LAST_PREVIOUS_LEVEL" = none ]; then
    plan_section "no grant before the change"
    plan_step run "remove the grant record for $SERVICE_USER" "[ ! -e $record ]" "rm -f $record"
    plan_tag grant
  else
    LEVEL="$LAST_PREVIOUS_LEVEL"
    load_level
    set_grant_paths "$LAST_PREVIOUS_PATHS_TEXT"
    plan_access_control
  fi
  plan_access_control_release
  plan_section "after alpha"
  plan_note "$(after_alpha_sessions)"
}

rollback_apply() {
  local status=0 record before
  # every one of these is set here, because lib/plan.sh takes none of them from the environment
  PLAN_RECORD_FILE="${PREFIX}$(layout_record_file)"
  PLAN_STEP_HOOK=audit_step_hook
  PLAN_RECHECK=no
  AUDIT_OPERATION="grant rollback"
  AUDIT_PENDING="$STAGE_DIR/audit-pending.jsonl"
  record="${PREFIX}$(access_control_record_file)"
  before="$STAGE_DIR/grant-before.json"
  if [ -f "$record" ]; then cp "$record" "$before"; fi
  plan_apply || status=$?
  if [ "$status" -eq 4 ]; then access_control_report_locked_account; fi
  if [ "$status" -ne 3 ]; then
    audit_grant_change "$before" "$record" rollback
  fi
  audit_flush
  return "$status"
}

rollback() {
  local strict=yes refusal log record
  PLAN_PREFIX="$PREFIX"
  PLAN_OPERATING_SYSTEM="$OPERATING_SYSTEM"
  if [ "$DRY_RUN" = yes ] || [ -n "$PREFIX" ]; then
    strict=no
  fi
  if [ "$DRY_RUN" != yes ]; then
    refusal="$(plan_real_apply_refusal)"
    [ -z "$refusal" ] || DIE_STATUS=3 die "not applied: $refusal"
  fi
  preflight_bash
  preflight_python "$OPERATING_SYSTEM"
  case "$OPERATING_SYSTEM" in
    linux) preflight_commands "$strict" setfacl getfacl ;;
  esac
  if [ "$PREFLIGHT_PROBLEMS" -gt 0 ]; then
    die "preflight found $PREFLIGHT_PROBLEMS problem(s); nothing was changed"
  fi

  log="${PREFIX}$(audit_log_file)"
  [ -e "$log" ] || die "no audit log at $log, so there is no grant change to roll back"
  [ -r "$log" ] || die "the audit log $log belongs to the owner; run this as the owner or with sudo"
  read_last_grant "$log"
  if [ -z "$LAST_TIME" ]; then
    say "no grant change for $SERVICE_USER in the audit log; nothing to roll back."
    return 0
  fi
  if [ "$LAST_SKIPPED" != 0 ]; then
    warn "$LAST_SKIPPED audit log lines are not JSON and were skipped"
  fi

  record="${PREFIX}$(access_control_record_file)"
  read_grant "$record" || DIE_STATUS=2 die "the grant record $record cannot be read; nothing was changed"
  if [ "$GRANT_LEVEL" != "$LAST_LEVEL" ] || [ "$GRANT_PATHS_TEXT" != "$LAST_PATHS_TEXT" ]; then
    printf 'error: the grant record no longer matches the last grant change in the audit log.\n' >&2
    printf '  record:    %s\n' "$(describe_grant "$GRANT_LEVEL" "$GRANT_PATHS_TEXT")" >&2
    printf '  audit log: %s, at %s\n' "$(describe_grant "$LAST_LEVEL" "$LAST_PATHS_TEXT")" "$LAST_TIME" >&2
    printf 'something changed it outside this package; nothing was changed. look with: sirven grant inspect\n' >&2
    exit 2
  fi

  PLAN_SIMULATION_LOG=""
  if [ -n "$PREFIX" ]; then
    PLAN_SIMULATION_LOG="$PREFIX$(layout_simulation_log)"
  fi
  build_rollback_plan
  plan_evaluate
  rollback_header
  plan_print
  plan_summary
  if [ "$DRY_RUN" = yes ]; then
    say "dry run: nothing was changed. run the same command without --dry-run to apply this plan."
    return 0
  fi
  lock_take 60 refuse
  rollback_apply
}

# the runtime is its own program, in python, so hand it everything after the word runtime.
run_runtime() {
  need_python
  PYTHONPATH="$ROOT_DIR/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m sirven_runtime "$@"
}

# keep-awake lives in a compiled helper program (macos/keep-awake), because a power assertion is
# held by a running process and released by the system when that process exits.
# SIRVEN_KEEP_AWAKE_BIN points at a build elsewhere, such as the one inside the signed app.
keep_awake() {
  local built candidate named="${SIRVEN_KEEP_AWAKE_BIN:-}"
  [ "$(detect_os)" = macos ] || die "sirven awake is for macos only"
  # the person's own program, for the person's own run: root runs only the build that goes with this package
  [ "$(id -u)" -ne 0 ] || named=""
  built="$ROOT_DIR/macos/keep-awake/.build"
  for candidate in "$named" "$built/release/sirven-keep-awake" "$built/debug/sirven-keep-awake"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      exec "$candidate" "$@"
    fi
  done
  die "sirven awake is not built yet. build it with: make keep-awake"
}

main() {
  if [ "${1:-}" = runtime ]; then
    shift
    run_runtime "$@"
  fi
  if [ "${1:-}" = awake ]; then
    shift
    keep_awake "$@"
  fi
  case "${1:-}" in
    add | remove)
      components_main "$@"
      exit $?
      ;;
  esac
  if [ "${1:-}" = phone ]; then
    shift
    command -v python3 >/dev/null 2>&1 || die "python3 was not found on PATH; the phone bridge needs it"
    exec python3 "$ROOT_DIR/lib/phone_bridge.py" "$@"
  fi
  parse_arguments "$@"
  OPERATING_SYSTEM="$(detect_os)"
  PACKAGE="$(package_name "$ROOT_DIR/project.json")"
  layout_set_directories
  STAGE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/$PACKAGE-grant.XXXXXX")"
  trap 'rm -rf "$STAGE_DIR"' EXIT
  case "$ACTION" in
    inspect) inspect ;;
    rollback) rollback ;;
    repair) repair_grant ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
