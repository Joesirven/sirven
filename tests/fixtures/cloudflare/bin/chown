#!/bin/sh
# a fake chown: a normal user cannot give a file to another account, so the call is recorded and nothing is changed
dir="${FAKE_ACCOUNTS_DIR:?FAKE_ACCOUNTS_DIR is not set}"
mkdir -p "$dir"
printf 'chown %s\n' "$*" >> "$dir/calls.log"
[ "${FAKE_CHOWN_FAILS:-}" != yes ] || { echo "chown: changing ownership: Operation not permitted" >&2; exit 1; }
exit 0
