# the disposable machine for a real Linux apply: a bare Debian with exactly the tools the
# installer's preflight asks for, and nothing else. the repository is not copied in; the run
# script mounts it read only, so one built image serves every run.
FROM debian:12-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash python3 acl passwd procps util-linux coreutils findutils diffutils \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
